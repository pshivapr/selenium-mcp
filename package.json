{
  "name": "selenium-webdriver-mcp",
  "version": "0.5.0",
  "mcpName": "io.github.pshivapr/selenium-webdriver-mcp",
  "description": "Selenium Tools for MCP",
  "type": "module",
  "bin": {
    "selenium-webdriver-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "version.config.json"
  ],
  "author": {
    "name": "V S Pasham"
  },
  "license": "MIT",
  "module": "src/index.ts",
  "scripts": {
    "build": "tsc && npm run copy:config",
    "copy:config": "node -e \"const fs=require('fs'); fs.copyFileSync('version.config.json', 'dist/version.config.json');\"",
    "copy": "cp version.config.json dist/",
    "start": "node dist/index.js",
    "dev": "nodemon src/index.ts --exec tsx",
    "clean": "rm -rf dist",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.{ts,js,json}",
    "format:check": "prettier --check src/**/*.{ts,js,json}",
    "type-check": "tsc --noEmit",
    "build:stdio": "tsc",
    "build:http": "npx @smithery/cli build",
    "build:test": "npm run build && npm run test",
    "start:http": "node .smithery/index.cjs",
    "start:stdio": "node dist/index.js",
    "prepublishOnly": "npm run version:sync && npm run build:stdio",
    "prepare": "husky",
    "test": "npm run build && node --test test/**/*.test.js",
    "test:watch": "npm run build && node --test --watch test/**/*.test.js",
    "test:health": "npm run build && node --test test/health-check.test.js",
    "version:sync": "node scripts/sync-version.js",
    "cleanup": "node scripts/cleanup.js"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pshivapr/selenium-mcp.git"
  },
  "keywords": [
    "selenium",
    "webdriver",
    "selenium-webdriver",
    "mcp",
    "modelcontextprotocol",
    "automation"
  ],
  "bugs": {
    "url": "https://github.com/pshivapr/selenium-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "selenium-webdriver": "^4.52.0",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "zod": "$zod",
    "minimatch": "^10.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@smithery/cli": "4.11.1",
    "@types/node": "^26.6.6",
    "@types/selenium-webdriver": "^4.35.7",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "esbuild": "^0.28.2",
    "esbuild-node-externals": "^2.0.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.10.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "@smithery/cli@4.11.1": true,
    "esbuild@0.28.2": true
  }
}
